{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnlySend",
  "version": "0.1.7",
  "identifier": "com.rxtsel.only-send",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "OnlySend",
        "width": 1024,
        "height": 600,
        "minWidth": 1024,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' asset:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "font-src": "'self' asset: http://asset.localhost https: http: data:",
        "img-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "style-src": "'self' 'unsafe-inline' https: http: data:",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb",
      "dmg",
      "nsis"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libglib2.0-bin",
          "xdg-utils"
        ]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/rxtsel/onlysend/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "onlysend"
        ]
      }
    }
  }
}
